# Copy this file to neural-lens.ini and edit, or do not: the Settings dialog in
# the lens's menu has a control for every setting here and writes this file.
# Every setting is optional. Command line and environment variables win over
# this file.

# The mpv install carrying the DLSS 5 Neural Rendering stack, meaning ReShade
# as the Vulkan layer plus dlss5-feed.addon64, renodx-dlss5.addon64,
# nvngx_dlss.dll and NVIDIA's nvngx_dlssnr.dll.
#
# If this is not set, the lens looks for an "mpv" folder beside the program and
# then the "stack" folder its own setup writes into the install. Nothing else on
# the machine is guessed at, so leave this commented out unless your stack lives
# somewhere of your own choosing.
# mpv_dir = D:\path\to\mpv

# Where the lens keeps its window position and its archived logs.
# Defaults to the data folder beside the program
# data_dir = D:\NeuralLens

# Where the before and after screenshots go.
# Defaults to data\screenshots beside the program
# screenshot_dir = D:\Screenshots\NeuralLens

# Frame pacing. Both default to the display's own refresh rate, so a 240 Hz
# monitor is paced at 240. Only set these to force something else.
#
# fps is a ceiling, not the rate the lens actually asks for. Five sixths of it
# is where the visible stage starts, divided by the number of neural passes. The
# lens then lowers the rate whenever the chain falls short, the output runs away
# in brightness, or the picture shimmers on still content, and probes back up
# while the picture stays clean. The margin is deliberate: asking a stage for
# even exactly what arrives makes mpv present frames that are not there yet,
# and the picture shimmers. Asking for far more makes it crush toward black or
# white and recover, repeatedly.
# fps = 120
# pump_hz = 120

# Set adaptive = 0 to keep the fixed rule above instead of adjusting it live.
# min_fps is the lowest rate the adjustment will go to. A full screen lens on a
# mid range card can need the floor.
# adaptive = 1
# min_fps = 12

# Highest number of neural passes the plus button will go to. Three is the
# default and the highest that is tested.
#
# Beyond three is experimental and may not work properly. At four passes the
# rate search has been measured hunting over a 40 fps spread on a still image,
# so the frame rate can swing and the picture can wander. Raising this is
# allowed because the ceiling is yours to set, not because four is ready.
# max_passes = 3

# What the title bar shows beside the size: fps, the frame rate the visible
# pass actually presents; detail, the capture rate in and the rate asked out;
# or size. The Settings dialog has this too.
# readout = fps

# Experimental. Cover the whole monitor the lens is on. This is the least
# tested part of the lens, so try it rather than rely on it. The Settings
# dialog has a checkbox for this and writes it here. Pass count and best held
# rate for the fullscreen chain are kept apart from the windowed ones.
# fullscreen = 0
