# Copy this file to neural-lens.ini and edit, or do not: the Settings dialog in
# the lens's menu has a control for most settings here and writes this file.
# Every setting is optional. Where a command line flag or an environment
# variable exists for a setting, it wins over this file: --stack-dir and
# NEURAL_LENS_STACK for the stack folder, NEURAL_LENS_DATA for the data folder.

# The folder holding the Neural Rendering stack: ReShade.ini, the two add-ons,
# NVIDIA's DLLs and lens-presenter.exe. The installed lens keeps its stack in
# its own folder, and from source neural_stack.py writes a "stack" folder
# beside the script; the lens finds both without this. mpv_dir, the name 0.1.0
# used, is read too.
# stack_dir = D:\path\to\stack

# Where the lens keeps its window position and its archived logs.
# Defaults to the data folder beside the program
# data_dir = D:\NeuralLens

# Where the before and after screenshots go.
# Defaults to data\screenshots beside the program
# screenshot_dir = D:\Screenshots\NeuralLens

# The DLSSNR Cost Scaler, which the setup puts in front of NVIDIA's model.
# fullscreen, the default, switches it on for a fullscreen lens and off for a
# windowed one; always applies the same rule to any lens; off keeps it off;
# manual leaves its ini alone. The scale is chosen so the model's work over all
# the passes comes to about cost_scaler_mpx megapixels: 8 is 6144x2560 at 0.70
# for one pass and 0.50 for two, 3840x2160 at native for one pass and 0.65 for
# two, and 2560x1440 at native up to two passes. A slower card can want less.
# cost_scaler = fullscreen
# cost_scaler_mpx = 8

# What the title bar shows beside the size: fps, the new pictures the lens shows
# each second; detail, the frames captured and the new pictures shown, each per
# second; or size. The Settings dialog has this too.
# readout = fps

# Show the delay from capture to display beside the frame rate. The Settings
# dialog has this too.
# latency = 0

# Cover the whole monitor the lens is on. The Settings dialog has a checkbox for
# this and writes it here. The pass count for fullscreen is kept apart from the
# windowed one.
# fullscreen = 0
